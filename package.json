{
  "name": "cortico-world-ego",
  "version": "0.1.11",
  "type": "module",
  "author": { "name": "筆離嘢" },
  "description": "Ego 浏览器 —— 专为 AI 打造的浏览器 World，让你家的小肥鱼上网、看图、看视频更顺手。Cortico 与 Coopanion 共用官方 ego-browser 接口，在独立 Space 里开网页、点击填表、截图，观看 HTML5 / B 站视频的画面、字幕与弹幕。需先安装 Ego Lite。",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/biliye/cortico-world-ego.git" },
  "homepage": "https://github.com/biliye/cortico-world-ego#readme",
  "publishConfig": { "registry": "https://registry.npmjs.org/", "access": "public" },
  "keywords": ["cortico-world", "cortico", "ego", "browser", "video", "bilibili"],
  "engines": { "node": ">=22" },
  "os": ["win32", "darwin"],
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world", "api": 6, "displayName": "Ego 浏览器", "icon": "assets/icon.webp",
    "tags": ["internet", "browser", "video", "external-setup", "high-cost"],
    "locales": { "en": { "displayName": "Ego Browser", "description": "Ego Browser — a browser built for AI, so your little fat fish (小肥鱼) browses, reads pages and watches videos more smoothly. For Cortico and Coopanion via the official ego-browser API: isolated task spaces, browsing, forms, screenshots, HTML5/Bilibili video frames, subtitles and danmaku. Requires an installed Ego Lite." } },
    "describe": "describe.json", "webUiClient": "dist/webui.js"
  },
  "files": ["src", "dist", "assets", "README.md", "describe.json", "CHANGELOG.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "typecheck": "tsc --noEmit", "test": "vitest run", "build:webui": "node scripts/build-webui.mjs",
    "smoke": "node --import ./scripts/register.mjs --experimental-transform-types scripts/smoke.ts",
    "smoke:helper": "node --import ./scripts/register.mjs --experimental-transform-types scripts/smoke-helper.ts",
    "smoke:tail": "node --import ./scripts/register.mjs --experimental-transform-types scripts/smoke-short-tail.ts",
    "smoke:continuity": "node --import ./scripts/register.mjs --experimental-transform-types scripts/smoke-continuity.ts",
    "smoke:sampling": "node --import ./scripts/register.mjs --experimental-transform-types scripts/smoke-sampling.ts",
    "prepack": "node scripts/build-webui.mjs", "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "devDependencies": { "@types/node": "^22.10.0", "typescript": "^5.7.2", "vitest": "^2.1.8", "esbuild": "^0.24.0" }
}
