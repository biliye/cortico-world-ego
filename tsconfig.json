{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"], "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "noEmit": true, "allowJs": true, "checkJs": false, "paths": { "cortico/*": ["../../cortico/src/*"] }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
